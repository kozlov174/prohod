    "@radix-ui/react-tabs": "latest",
    "@vercel/analytics": "^1.3.1",
    "autoprefixer": "^10.4.16",
    "bcrypt": "^5.1.1",
    "bcryptjs": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.3.1",
