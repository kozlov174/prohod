  "private": true,
  "description": "QR Ticket Management System",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "docker:build": "docker build -t qr-ticket-system .",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up --build",
